<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <!--
        One suite, because there is one kind of test so far: Feature tests that
        exercise the application through its HTTP boundary. A Unit suite gets
        added in the change that introduces the first piece of pure domain
        logic worth testing on its own, not before.
    -->
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!--
            Not a secret. It is fixed so the suite is deterministic and runs
            without a .env, and it exists nowhere else. The real key comes from
            the environment; see .env.example.
        -->
        <env name="APP_KEY" value="base64:Q2xhdWRlQ29tbWVyY2VUZXN0S2V5MDEyMzQ1Njc4OTA="/>

        <!--
            Tests run against PostgreSQL, not an in-memory SQLite database.

            SQLite would be faster and would run anywhere, and it would also
            quietly not test the thing that matters. This is a marketplace:
            money is exact numeric, invariants are database CHECK constraints,
            and uniqueness is partial indexes. SQLite has different semantics
            for all three, and it accepts values PostgreSQL rejects. A suite
            that passes on an engine nobody deploys is a suite that reports on
            an application nobody runs.

            The database name is not set here. tests/bootstrap.php derives it
            from DB_DATABASE by appending _test, so the name exists once and
            the suite cannot be pointed at the development database by an
            environment variable somebody forgot to override.

            force="true" below is load-bearing and not tidiness: without it
            PHPUnit leaves an existing environment variable alone, and the
            container already sets DB_CONNECTION.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>

        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
