<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <!--
        One suite, because there is one kind of test so far: Feature tests that
        exercise the application through its HTTP boundary. A Unit suite gets
        added in the change that introduces the first piece of pure domain
        logic worth testing on its own, not before.
    -->
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <!--
        There is deliberately no <php><env> block here.

        It would not work. Every variable this suite needs to control is one
        that docker-compose.yml passes to the api service, and PHPUnit cannot
        override those: its force writes getenv() and $_ENV, Docker's value is
        in $_SERVER, and Laravel's Env reads $_SERVER first. The override looks
        applied and does nothing.

        tests/bootstrap.php sets all three superglobals instead, and explains
        which variable made that worth finding out.
    -->
</phpunit>
