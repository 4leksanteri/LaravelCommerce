    {
      "name": "seller",
      "item": [
        {
          "name": "Answers 200 with `data: null` when there is no application yet",
          "request": {
            "name": "Answers 200 with `data: null` when there is no application yet",
            "description": {
              "content": "This is the one seller endpoint deliberately **not** behind the `seller`\nmiddleware, because it is the question \"do I have a shop\" and the answer\n\"no\" is not an error. Almost every account on a marketplace has no shop,\nand the frontend asks this on every page load to decide what the\nnavigation says - answering 403 would mean wrapping a routine question\nin a try/catch and filling the logs with refusals that mean nothing.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "seller"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
