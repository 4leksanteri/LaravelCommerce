                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "name": "Behind the `seller` middleware, so there is no \"you have no shop\" branch\nhere: a caller without one never arrives",
          "request": {
