# Laravel Commerce - environment
#
# Copy to .env and fill in. `make setup` does that and generates APP_KEY.
#
# THERE IS ONE ENV FILE, AND THIS IS IT. There is deliberately no
# apps/api/.env: Compose reads this file and passes each service the subset it
# needs, and Laravel reads those values straight out of the container
# environment. Two files describing one deployment is how a value gets changed
# in one of them.
#
# Every variable a service needs is listed in docker-compose.yml. A variable
# that is not listed there does not reach the container, however carefully it
# is set here - that allowlist is the point, not an inconvenience.
#
# Never commit .env. Never put a secret in a variable whose name starts with
# NEXT_PUBLIC_; Next inlines those into the browser bundle.


# --- Identity ---------------------------------------------------------------

APP_NAME="Laravel Commerce"

# local | production. Drives Laravel's own defaults and is checked by the
# production entrypoint before it caches anything.
APP_ENV=local

# Generated by `make setup`, or `make key` for an existing .env. Laravel
# encrypts cookies and signs sessions with it: changing it in production signs
# every user out and makes every encrypted column unreadable.
APP_KEY=

# Never true outside local development. Laravel's debug output includes the
# environment, and this application's exception handler renders it as JSON to
# whoever asked.
APP_DEBUG=true


# --- Addresses --------------------------------------------------------------
#
# Three different addresses, and they are not interchangeable.

# What the API calls itself. Used for signed URLs and anything Laravel has to
# address on its own host. Not a public address - see docker-compose.yml.
APP_URL=http://localhost:8000

# Where a person actually is. Every link in an email points here, because the
# API is not reachable from a browser. Scheme included.
FRONTEND_URL=http://localhost:3000

# Which origins may hold a session (ADR 0002). Host and port, no scheme,
# comma-separated. This is matched against the browser's Origin/Referer as
# forwarded by the proxy, so it names the *public web* origin - never the API's
# address, and never a wildcard.
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Where the Next.js server finds the API, on the internal Docker network. The
# only place this address exists (ADR 0003). It is server-side only and must
# never be given a NEXT_PUBLIC_ name.
API_INTERNAL_URL=http://api:8000


# --- Ports published to the host --------------------------------------------
#
# Development convenience only. In production the API publishes nothing: it is
# reachable on the internal network and nowhere else.

WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432


# --- Database ---------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel_commerce
DB_USERNAME=laravel_commerce
DB_PASSWORD=change-me-in-production


# --- Session ----------------------------------------------------------------

# The session lives in Postgres. There is no Redis in this stack yet, and none
# should be added until a workload needs one it cannot get from the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Host-only, deliberately. A cookie scoped to a shared parent domain is a
# cookie every sibling subdomain can read.
SESSION_DOMAIN=null

# true in production, where the site is HTTPS. Leave false locally or the
# browser will refuse to store the cookie over plain HTTP and nobody will be
# able to sign in.
SESSION_SECURE_COOKIE=false


# --- Cache and queue --------------------------------------------------------

CACHE_STORE=database
QUEUE_CONNECTION=database


# --- Mail -------------------------------------------------------------------
#
# In development this is Mailpit: a real SMTP server that accepts everything
# and delivers nothing. Read what was sent at http://localhost:8025.
#
# `log` is fine for a moment of debugging and is not a default worth keeping.
# Registration, email verification and password reset all send mail, and a
# transport that silently discards it makes each of them look like it worked.
#
# In production these point at a real provider, and docker-compose.prod.yml
# refuses to start without MAIL_MAILER, MAIL_HOST and MAIL_FROM_ADDRESS.

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@laravelcommerce.test"
MAIL_FROM_NAME="${APP_NAME}"

# Mailpit's web inbox, and its SMTP port on the host. Development only.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# --- Logging ----------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
