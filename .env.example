# Laravel Commerce - environment
#
# Copy to .env and fill in. `make setup` does that and generates APP_KEY.
#
# THERE IS ONE ENV FILE, AND THIS IS IT. There is deliberately no
# apps/api/.env: Compose reads this file and passes each service the subset it
# needs, and Laravel reads those values straight out of the container
# environment. Two files describing one deployment is how a value gets changed
# in one of them.
#
# Every variable a service needs is listed in docker-compose.yml. A variable
# that is not listed there does not reach the container, however carefully it
# is set here - that allowlist is the point, not an inconvenience.
#
# Never commit .env. Never put a secret in a variable whose name starts with
# NEXT_PUBLIC_; Next inlines those into the browser bundle.


# --- Identity ---------------------------------------------------------------

APP_NAME="Laravel Commerce"

# local | production. Drives Laravel's own defaults and is checked by the
# production entrypoint before it caches anything.
APP_ENV=local

# Generated by `make setup`, or `make key` for an existing .env. Laravel
# encrypts cookies and signs sessions with it: changing it in production signs
# every user out and makes every encrypted column unreadable.
APP_KEY=

# Never true outside local development. Laravel's debug output includes the
# environment, and this application's exception handler renders it as JSON to
# whoever asked.
APP_DEBUG=true


# --- Addresses --------------------------------------------------------------
#
# Three different addresses, and they are not interchangeable.

# What the API calls itself. Used for signed URLs and anything Laravel has to
# address on its own host. Not a public address - see docker-compose.yml.
APP_URL=http://localhost:8000

# Where a person actually is. Every link in an email points here, because the
# API is not reachable from a browser. Scheme included.
FRONTEND_URL=http://localhost:3000

# Which origins may hold a session (ADR 0002). Host and port, no scheme,
# comma-separated. This is matched against the browser's Origin/Referer as
# forwarded by the proxy, so it names the *public web* origin - never the API's
# address, and never a wildcard.
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Where the Next.js server finds the API, on the internal Docker network. The
# only place this address exists (ADR 0003). It is server-side only and must
# never be given a NEXT_PUBLIC_ name.
API_INTERNAL_URL=http://api:8000


# --- Ports published to the host --------------------------------------------
#
# Development convenience only. In production the API publishes nothing: it is
# reachable on the internal network and nowhere else.

WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432


# --- Database ---------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel_commerce
DB_USERNAME=laravel_commerce
DB_PASSWORD=change-me-in-production


# --- Session ----------------------------------------------------------------

# The session lives in Postgres. There is no Redis in this stack yet, and none
# should be added until a workload needs one it cannot get from the database.
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Host-only, deliberately. A cookie scoped to a shared parent domain is a
# cookie every sibling subdomain can read.
SESSION_DOMAIN=null

# true in production, where the site is HTTPS. Leave false locally or the
# browser will refuse to store the cookie over plain HTTP and nobody will be
# able to sign in.
SESSION_SECURE_COOKIE=false


# --- Cache and queue --------------------------------------------------------

CACHE_STORE=database
QUEUE_CONNECTION=database


# --- Mail -------------------------------------------------------------------
#
# In development this is Mailpit: a real SMTP server that accepts everything
# and delivers nothing. Read what was sent at http://localhost:8025.
#
# `log` is fine for a moment of debugging and is not a default worth keeping.
# Registration, email verification and password reset all send mail, and a
# transport that silently discards it makes each of them look like it worked.
#
# In production these point at a real provider, and docker-compose.prod.yml
# refuses to start without MAIL_MAILER, MAIL_HOST and MAIL_FROM_ADDRESS.

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@laravelcommerce.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Orders ------------------------------------------------------------------
#
# How long an order may wait for its seller before `orders:expire` cancels it
# and hands the stock back. Nothing else releases stock that checkout took.
#
# Three days rather than one, deliberately. `pending` currently means "waiting
# for the seller to accept" rather than "unpaid", so the clock is running on a
# person - and a shorter window cancels real orders from patient buyers because
# a small shop was closed for the weekend.
#
# This shortens a great deal when payments arrive, because `pending` will then
# mean nobody has paid. See docs/architecture/0013-scheduled-work.md.

ORDER_PENDING_EXPIRES_AFTER_HOURS=72

# How long a shipped order waits for its buyer to confirm receipt before
# `orders:auto-complete` does it on their behalf. Buyers forget, and an order
# that stays shipped forever never releases a payout.
#
# A buyer whose parcel is late can push this back twice, seven days each time -
# so 28 days from posting before the marketplace assumes delivery. That part is
# in config/orders.php rather than here, because it is product design rather
# than deployment tuning.

ORDER_AUTO_COMPLETE_AFTER_DAYS=14

# --- Stripe Connect -----------------------------------------------------------
#
# **Test keys only.** There is no live key in this repository and there will not
# be one: the whole of this runs in Stripe test mode (ADR 0015).
#
# To fill these in:
#
#   1. dashboard.stripe.com, and make sure the Test mode switch is on
#   2. Developers -> API keys -> Secret key. It starts `sk_test_`, and a key
#      that does not is refused at the first call (ADR 0031)
#   3. Connect -> get started, and finish the platform profile, so connected
#      accounts can be created at all
#   4. `make stripe-listen` forwards test webhooks to this stack, both the
#      platform's and its connected accounts', and prints the `whsec_` signing
#      secret to use below. It is a different secret from the API key, and it
#      is what proves a webhook actually came from Stripe.
#   5. `make restart`, because the api container reads these when it starts
#
# Empty here on purpose. Reading a shop's payout account needs neither of them.
# Opening one, sending details to Stripe and receiving a webhook each fail
# loudly without them, rather than quietly at the worst possible moment.

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# The key Stripe.js loads with in the browser, from the same dashboard page as
# the secret one. It is publishable: it can turn a card into a payment method
# and nothing else, and it is useless for reading or moving money.
#
# It has no NEXT_PUBLIC_ name on purpose. The API sends it to the browser with
# the payment that needs it, so every Stripe setting lives here and the web
# application holds no Stripe configuration of its own (ADR 0040).
STRIPE_PUBLISHABLE_KEY=

# The platform's own country. Nothing reads it yet: where a shop may open its
# account is PayoutCountry's list, which assumes a European platform like this
# one. It matters when charges are built, because it decides the currency they
# settle in (ADR 0031).
STRIPE_PLATFORM_COUNTRY=FI

# What the marketplace keeps, in basis points: 500 is five per cent. Taken out
# of the transfer when an order completes, so the shop receives its total less
# this (ADR 0040). Basis points rather than a percentage because money is never
# a float (ADR 0004).
STRIPE_PLATFORM_FEE_BPS=500

# How long an order that nobody has paid for holds its stock before it is
# cancelled. Minutes, not the three days an accepted order waits: nobody has
# committed to anything yet, and it is sitting on the last of something.
ORDER_UNPAID_EXPIRES_AFTER_MINUTES=30

# --- Product images -----------------------------------------------------------
#
# Which filesystem disk new product images are written to. Every image row also
# records the disk it was written to, so changing this moves new uploads without
# orphaning anything already stored (ADR 0016).
#
# `products` is a private local disk. Images are served by a route under
# /api/v1, not by a file server - see docs/architecture/0003-the-proxy-boundary.md.

PRODUCT_IMAGE_DISK=products

# Mailpit's web inbox, and its SMTP port on the host. Development only.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025


# --- Logging ----------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
